# ewave environment — copy to .env or export in your shell. NEVER commit real keys.

# --- data adapters (only needed on machines with network access + accounts) ---
# Alpaca market data (data/adapters/alpaca_rest.py, scripts/alpaca_fetch.py)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Financial Modeling Prep (data/adapters/fmp_rest.py)
FMP_API_KEY=

# --- platform flags ---
# Override the configs/ directory (defaults to ./configs)
#EWAVE_CONFIG_DIR=

# Live trading master switch. Leave unset. Live mode ALSO requires
# execution.json mode=live, risk.json live_enabled=true, a paper-trading
# report on disk, and no kill-switch file — and even then the shipped live
# executor refuses to trade (docs/LIVE_TRADING_SAFETY_POLICY.md).
#EWAVE_ENABLE_LIVE=
