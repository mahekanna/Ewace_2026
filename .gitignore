# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Data scratch (keep curated arrays in data/*.py, not raw dumps)
*.parquet
*.csv
scratch/

# ewave run outputs — keep the directory structure (.gitkeep) and markdown
# reports; ignore bulky run artifacts (ledgers, snapshots, logs)
outputs/*/*
!outputs/*/.gitkeep
!outputs/*/*.md
outputs/KILL_SWITCH

# local env files
.env

# Copyrighted third-party source material (Ashish Kyal / SOW course PDFs + project
# zip bundles) — preserved on disk for reference but deliberately NOT committed to
# version control; the derived searchable rules live in docs/RULES_LEDGER.md,
# docs/research/sow_deep_read/, and docs/atlas/. See docs/source_material/README.md.
docs/source_material/instructor_pdfs/
docs/source_material/zip_archives/
